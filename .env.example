# ==============================================================================
# ThinkTab AI - Environment Variables Template
# ==============================================================================
# COPY this file to '.env' and replace the placeholder values with your real keys.
# Do NOT commit the real '.env' file to version control.

# Required for the Fast Brain (gpt-4o-mini) and Auto Router
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Required for the Smart Brain (llama-3.3-70b via Groq)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: Required for Web Search Fallback (Serper API)
SERPER_API_KEY=your_serper_key_here
